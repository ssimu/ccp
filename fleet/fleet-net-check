#!/usr/bin/env python3
"""fleet-net-check [--all] [--json] — 나가는 연결이 막히기 전에 알아챈다.

macOS 26 결함(2026-11-11 macmini 실측): 부팅 후 약 49.7일(2^32 ms)이 지나면 TCP 내부 시계가 넘쳐
TIME_WAIT 연결이 사라지지 않는다. 몇 시간에 걸쳐 수만 개가 쌓이면 새 연결에 쓸 포트가 바닥나
`connect` 가 곧바로 "Can't assign requested address" 로 실패한다 — 공유기·Wi‑Fi 를 재시작해도 안 낫고
재부팅만 고친다. 들어오는 연결(ssh·웹앱)은 계속 되므로 겉으로는 Wi‑Fi 문제처럼 보인다.
같은 날 macOS 15.7(wooui, 164일)·13.7(old-mbp)은 멀쩡했다.

판정(이 Mac):
  - macOS 26 이상이고 부팅 후 UPTIME_WARN 일 이상 → "재부팅 필요(결함까지 D-n)"
  - TIME_WAIT 가 TW_WARN 개 이상 → 쌓이는 중
  - 1.1.1.1:443 으로 TCP 연결이 안 됨 → 지금 막힘
--all 은 hc 로 붙은 기계마다 같은 검사를 돌린다(키체인 불필요라 hc exec 로 충분).
출력 JSON: {"host","os","uptime_days","time_wait","outbound","warn":[…]} (--all 이면 그 목록)
"""
import json
import os
import re
import socket
import subprocess
import sys
import time

BUG_DAYS = 49.7
UPTIME_WARN = 42          # 결함 일주일 전부터 알린다
TW_WARN = 10000
HC = os.path.expanduser("~/.local/bin/hc")


def os_major(ver):
    try:
        return int(str(ver).split(".")[0])
    except ValueError:
        return 0


def judge(os_ver, uptime_days, time_wait, outbound):
    """판정만(시험 대상). 경고 문장 목록을 돌려준다."""
    warn = []
    if outbound is False:
        warn.append("나가는 연결 실패 — 지금 인터넷·LAN 으로 새 연결이 안 됨")
    if time_wait is not None and time_wait >= TW_WARN:
        warn.append(f"TIME_WAIT {time_wait}개 쌓임(포트 고갈 위험)")
    if os_major(os_ver) >= 26 and uptime_days is not None and uptime_days >= UPTIME_WARN:
        left = BUG_DAYS - uptime_days
        when = f"결함까지 {left:.1f}일" if left > 0 else f"결함 구간 {-left:.1f}일째"
        warn.append(f"부팅 {uptime_days:.1f}일째, 재부팅 필요({when}, macOS {os_ver})")
    return warn


def _out(args, timeout=20):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def local():
    ver = _out(["sw_vers", "-productVersion"]).strip()
    m = re.search(r"sec = (\d+)", _out(["sysctl", "-n", "kern.boottime"]))
    up = (time.time() - int(m.group(1))) / 86400 if m else None
    ns = _out(["netstat", "-an", "-p", "tcp"], 30)
    tw = sum(1 for l in ns.splitlines() if l.rstrip().endswith("TIME_WAIT")) if ns else None
    try:
        s = socket.create_connection(("1.1.1.1", 443), timeout=6)
        s.close()
        ok = True
    except OSError:
        ok = False
    return {"host": socket.gethostname().split(".")[0], "os": ver,
            "uptime_days": round(up, 1) if up is not None else None,
            "time_wait": tw, "outbound": ok, "warn": judge(ver, up, tw, ok)}


def remote(name):
    me = os.path.realpath(__file__)
    try:
        p = subprocess.run([HC, "exec", "--on", name, "--timeout", "60", "python3", me],
                           capture_output=True, text=True, timeout=75)
        line = next((l for l in reversed(p.stdout.splitlines()) if l.startswith("{")), "")
        r = json.loads(line)
        r["host"] = name
        return r
    except Exception as e:
        return {"host": name, "error": type(e).__name__, "warn": [f"검사 실패({type(e).__name__})"]}


def machines():
    try:
        d = json.loads(_out([HC, "machine", "ls", "--json"]))
        return [m["name"] for m in d.get("machines", []) if m.get("state") == "connected"]
    except Exception:
        return []


def main():
    if "--all" in sys.argv:
        rows = [local()] + [remote(m) for m in machines()]
        if "--json" in sys.argv:
            print(json.dumps(rows, ensure_ascii=False))
        else:
            for r in rows:
                print(f"{r['host']:10} {r.get('os','?'):6} 부팅 {r.get('uptime_days','?')}일  TIME_WAIT {r.get('time_wait','?')}  "
                      f"나가는 연결 {'됨' if r.get('outbound') else '안 됨'}" + "".join(f"\n  ! {w}" for w in r["warn"]))
        return
    print(json.dumps(local(), ensure_ascii=False))


if __name__ == "__main__":
    main()
