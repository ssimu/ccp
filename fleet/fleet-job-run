#!/bin/zsh
# fleet-job-run <id> <profile> — 함대 작업 하나를 이 Mac 에서 돌린다. 관문(old-mbp)의 fleet-dispatch 가 hc 터미널에서 부른다.
#   작업문은 ~/.local/share/fleet-jobs/<id>.task, 결과는 같은 폴더의 <id>.result.md (에이전트가 쓴다).
#   claude 의 '이 폴더를 신뢰합니까' 대화상자를 프로필 .claude.json 에 미리 적어 막고, ccp 로 그 프로필의 Claude Code 를 띄운다.
set -u
id="$1"; profile="$2"
J="$HOME/.local/share/fleet-jobs"; mkdir -p "$J"
task="$J/$id.task"; result="$J/$id.result.md"
[[ -f "$task" ]] || { echo "no task file: $task" >&2; exit 2; }
cwd="$PWD"
cfg="$HOME/.claude.json"; [[ "$profile" != default ]] && cfg="$HOME/.claude-profiles/$profile/.claude.json"
python3 - "$cfg" "$cwd" <<'PY'
import json, os, sys
f, cwd = sys.argv[1], sys.argv[2]
try: d = json.load(open(f))
except Exception: d = {}
p = d.setdefault("projects", {})
for k in {cwd, os.path.realpath(cwd)}:
    p.setdefault(k, {})["hasTrustDialogAccepted"] = True
# --dangerously-skip-permissions 의 첫 수락 화면도 미리 적어 둔다.
d["bypassPermissionsModeAccepted"] = True
# 첫 실행 온보딩(테마 고르기)도 터미널을 붙잡는다 — 한 번도 안 띄운 프로필이면 완료로 적어 둔다.
if not d.get("hasCompletedOnboarding"):
    d["hasCompletedOnboarding"] = True
    d.setdefault("theme", "dark")
    d.setdefault("lastOnboardingVersion", "2.1.0")
json.dump(d, open(f, "w"), indent=2)
PY
rm -f "$result"
prompt="$(cat "$task")

---
[함대 작업 $id] 작업이 끝나면 결과 요약(무엇을 했고 무엇이 남았는지, 10줄 이내)을 파일 $result 에 써라. 질문이 생기거나 막히면 그 내용을 같은 파일에 '질문:' 으로 시작해 적고 멈춰라. 에이전트를 더 띄우지 말고, 이 폴더 밖은 건드리지 마라. 커밋·push·발송은 작업문이 명시할 때만 한다."
sel="$profile"; [[ "$profile" == default ]] && sel=0
exec zsh -lic 'CCP_PICK_SESSION=0 ccp "$1" --dangerously-skip-permissions "$2"' _ "$sel" "$prompt"
