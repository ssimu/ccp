#!/usr/bin/env python3
"""fleet-jobs — 관문(old-mbp)에서 함대 Mac 에 Claude Code 작업을 투입하고 결과를 회수한다. Hermes 가 SSH 로 부른다.

  fleet-jobs dispatch [--project J] [--agent claude|codex] [--on M] [--profile P] [--cwd D] [--name N] (TASK | -)   # '-' 는 stdin
  fleet-jobs list [--all] [--project J]   # 살아 있는 작업 (--all: 끝난 것도)
  fleet-jobs projects                # 프로젝트 등록부(~/.config/ccp/fleet-projects.json)
  fleet-jobs status <id>
  fleet-jobs wait <id> [--timeout S]  # 끝날 때까지(기본 150초) 기다렸다가 결과까지 출력
  fleet-jobs result <id>             # 결과 파일(없으면 화면 꼬리)
  fleet-jobs send <id> <message>     # 돌고 있는 에이전트에 지시 추가
  fleet-jobs stop <id>
  fleet-jobs ask --on M --terminal T [--project J] [--name N] (QUESTION | -)
                                     # 사람의 대화형 터미널에서 나온 질문을 '결정 필요'로 올린다(투입 작업이 아님).
                                     # 컴퓨터에서 그 터미널에 직접 답하면 다음 확인 때 저절로 닫힌다. send 로 답하면 그 터미널에 넣고 닫는다.
  fleet-jobs unreported              # 끝났는데 아직 알리지 않은 작업을 출력하고 알림 처리 (cron 용, 없으면 무출력)
  fleet-jobs clean [--age H]         # 알린 지 H시간(기본 6) 지난 작업의 터미널 정리
  fleet-jobs machines

J = 등록부의 프로젝트 이름 — 기계·폴더·프로필·codex 프로필 기본값을 채운다(명시한 인자가 이긴다).
에이전트가 결과 파일을 '질문:' 으로 시작하면 상태가 '결정 필요'(question) 다 — 답은 fleet-jobs send.
M = local(이 Mac) 또는 `hc machine ls` 의 이름. 실행은 각 Mac 의 데스크톱 core 의 hc 터미널에서 ~/.local/bin/fleet-job-run 이 한다.
작업 기록: ~/.local/share/fleet-jobs/<id>.json (이 Mac).  결과: 대상 Mac 의 ~/.local/share/fleet-jobs/<id>.result.md
"""
import json, os, subprocess, sys, time, datetime, argparse, shlex

HOME = os.path.expanduser("~")
HC = os.path.join(HOME, ".local/bin/hc")
REG = os.path.join(HOME, ".local/share/fleet-jobs")
CFG = os.path.join(HOME, ".config/ccp/fleet-dispatch.json")
PROJECTS = os.path.join(HOME, ".config/ccp/fleet-projects.json")
TERMINAL = {"done", "question", "answered", "blocked", "error", "exited", "stopped", "lost"}
AGENTS = ("claude", "codex")


def now():
    return datetime.datetime.now().astimezone().replace(microsecond=0)


def cfg():
    try:
        return json.load(open(CFG))
    except Exception:
        return {"default_cwd": "~/fleet-work", "machines": {}}


def projects():
    """프로젝트 등록부. 없거나 깨졌으면 빈 dict — --project 없는 투입은 그대로 된다."""
    try:
        d = json.load(open(PROJECTS))
        return d.get("projects", {}) if isinstance(d, dict) else {}
    except Exception:
        return {}


def resolve(conf, projs, on, project, profile, cwd, agent):
    """투입 값 결정: 명시한 인자 > 프로젝트 > 머신 기본값 > 전체 기본값."""
    pj = {}
    if project:
        if project not in projs:
            raise ValueError(f"없는 프로젝트: {project} (가능: {', '.join(sorted(projs)) or '등록부 비어 있음'})")
        pj = projs[project]
    agent = agent or pj.get("agent") or "claude"
    if agent not in AGENTS:
        raise ValueError(f"모르는 에이전트: {agent} (가능: {', '.join(AGENTS)})")
    m = on or pj.get("machine") or "local"
    m = conf.get("aliases", {}).get(m, m)   # 관문 자신의 이름(예: macmini) → local. 관문을 옮겨도 "macmini 에서" 가 통한다
    mc = conf.get("machines", {}).get(m, {})
    return {"machine": m,
            "profile": profile or pj.get("profile") or mc.get("profile") or conf.get("profile") or "default",
            "cwd": cwd or pj.get("cwd") or mc.get("cwd") or conf.get("default_cwd", "~/fleet-work"),
            "agent": agent,
            "codex_profile": pj.get("codex_profile") or mc.get("codex_profile") or conf.get("codex_profile") or "default",
            "project": project or None}


def settle(r0, conf, pick):
    """'auto' 인 계정을 그 Mac 의 사용량으로 정한다. pick(machine, agent) -> {"profile", "weekly"} 또는 None.
    고를 게 없으면(전부 한도 근처·조회 실패) 머신의 fallback_profile → default. 명시한 계정은 건드리지 않는다."""
    r = dict(r0)
    key = "profile" if r["agent"] == "claude" else "codex_profile"
    if r[key] != "auto":
        return r
    try:
        got = pick(r["machine"], r["agent"])
    except Exception:
        got = None
    if got and got.get("profile"):
        r[key] = got["profile"]; r["picked"] = f"자동 · 주간 {got.get('weekly')}%"
    else:
        mc = conf.get("machines", {}).get(r["machine"], {})
        fb = (mc.get("fallback_profile") if key == "profile" else mc.get("fallback_codex_profile")) or "default"
        r[key] = fb; r["picked"] = f"자동 실패 → 대체 {fb}"
    return r


def pick_remote(conf):
    """대상 Mac 에서 fleet-pick 을 돌린다(hc 경로, 키체인 열림)."""
    excl = ",".join(conf.get("exclude_profiles", ["imok"]))
    mx = str(conf.get("max_weekly_pct", 80))
    def pick(machine, agent):
        cmd = f"~/.local/bin/fleet-pick {agent} --exclude {shlex.quote(excl)} --max {mx}"
        if machine == "local":
            p = subprocess.run(["zsh", "-lc", cmd], capture_output=True, text=True, timeout=60)
        else:
            p = hc("exec", "--on", machine, "zsh", "-lc", cmd, timeout=60)
        line = next((l for l in reversed(p.stdout.splitlines()) if l.startswith("{")), "")
        return json.loads(line) if line else None
    return pick


def classify(hc_state, status, turn, result_text):
    """hc 상태와 결과 파일로 작업 단계를 정한다. 결과 파일이 먼저 — 끝나 나간 codex 도, 결과 뒤 홍보 대화상자도 결과로 본다."""
    if result_text is not None:
        return "question" if result_text.lstrip().startswith("질문") else "done"
    if hc_state == "finished":
        return "exited"
    if status == "blocked":
        return "blocked"
    if status == "error":
        return "error"
    if status in ("idle", "done"):
        return "idle"
    if status is None and (turn or 0) == 0:
        return "starting"
    return "running"


class _Timeout:
    returncode = 124; stdout = ""; stderr = '{"error":"hc call timed out"}'


def hc(*args, timeout=60, check=False):
    try:
        p = subprocess.run([HC, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        p = _Timeout()   # SSH 맥락에서 `hc wait` 가 --timeout 을 넘겨 안 돌아올 때가 있다 — 폴링으로 넘어간다
    if check and p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip())
    return p


def hc_json(*args, timeout=60):
    p = hc(*args, "--json", timeout=timeout)
    out = p.stdout.strip() or p.stderr.strip()
    try:
        return json.loads(out)
    except Exception:
        return {"error": out[-400:], "rc": p.returncode}


def machines():
    d = hc_json("machine", "ls")
    return {m["name"]: m.get("state") for m in d.get("machines", [])}


def on(machine):
    return [] if machine == "local" else ["--on", machine]


def remote_read(machine, path):
    """대상 Mac 의 파일 내용. 없으면 None."""
    if machine == "local":
        p = os.path.expanduser(path)
        return open(p, errors="replace").read() if os.path.exists(p) else None
    p = hc("exec", "--on", machine, "sh", "-c", f"test -f {path} && cat {path} || echo __FLEET_NOFILE__", timeout=40)
    out = p.stdout
    if "__FLEET_NOFILE__" in out or p.returncode:
        return None
    return out


def load(jid):
    f = os.path.join(REG, jid + ".json")
    if not os.path.exists(f):
        sys.exit(f"없는 작업: {jid}")
    return json.load(open(f))


def save(j):
    os.makedirs(REG, exist_ok=True)
    json.dump(j, open(os.path.join(REG, j["id"] + ".json"), "w"), ensure_ascii=False, indent=1)


def all_jobs():
    os.makedirs(REG, exist_ok=True)
    return [json.load(open(os.path.join(REG, f))) for f in sorted(os.listdir(REG)) if f.endswith(".json")]


def phase(j, refresh=True):
    """running | idle | done | question | blocked | error | exited | stopped | lost 와 hc 상태를 j 에 적어 돌려준다."""
    if j.get("phase") in TERMINAL and not refresh:
        return j["phase"]
    if j.get("phase") in ("stopped",):
        return "stopped"
    if j.get("kind") == "ask":
        return ask_phase(j)
    g = hc_json("get", j["address"], timeout=30)
    if "error" in g or not g.get("address"):
        # 터미널이 없다 — 끝나면 나가는 codex 는 hc 가 터미널을 치운다. 결과 파일이 있으면 그것으로 판정한다.
        res = remote_read(j["machine"], j["result"])
        if res is not None:
            j["result_text"] = res.strip(); j["phase"] = classify("finished", None, 1, res.strip())
        else:
            j["phase"] = "lost"; j["hc"] = str(g.get("error", ""))[:200]
        if not j.get("finished_at"):
            j["finished_at"] = now().isoformat()
        save(j)
        return j["phase"]
    st = g.get("status") or {}
    state = st.get("state") if isinstance(st, dict) else st
    j["hc"] = {"state": g.get("state"), "status": state, "turn": g.get("turn"), "exit_code": g.get("exit_code")}
    # 결과 파일이 있으면 끝난 것 — 그 뒤에 뜨는 홍보 대화상자(blocked)는 무시. 상태 보고가 없는 옛 claude(2.1.265 등)도 이걸로 잡는다.
    res = remote_read(j["machine"], j["result"])
    if res is not None:
        j["result_text"] = res.strip()
    ph = classify(g.get("state"), state, g.get("turn", 0), None if res is None else res.strip())
    j["phase"] = ph
    if ph == "starting":
        # 아직 에이전트 상태 보고가 없다 — 첫 실행 대화상자에 잡혔는지 화면으로 본다. 아는 것은 자동으로 넘긴다.
        tail = screen_tail(j, 14)
        j["phase"] = "running"
        if "Enter to confirm" in tail or "Enter to continue" in tail:
            keys = auto_dialog_keys(tail)
            if keys:
                hc("keys", j["address"], *keys, timeout=30)
                j.setdefault("auto_dialogs", []).append(keys[-1] + ":" + next((l.strip() for l in tail.splitlines() if l.strip()), "")[:60])
                time.sleep(2)
            else:
                j["phase"] = "dialog"; j["dialog"] = tail
    if j["phase"] in TERMINAL and not j.get("finished_at"):
        j["finished_at"] = now().isoformat()
    save(j)
    return j["phase"]


def ask_phase(j):
    """대화형 질문: 열려 있는 동안 그 터미널이 다시 일하기 시작했으면 사람이 컴퓨터에서 답한 것 — 닫는다."""
    if j.get("phase") != "question":
        return j["phase"]
    g = hc_json("get", j["address"], timeout=30)
    st = g.get("status") or {}
    state = st.get("state") if isinstance(st, dict) else st
    if "error" in g or not g.get("address") or g.get("state") != "live":
        j["phase"] = "answered"; j["answer"] = "(터미널이 없어져 닫음)"
    elif not j.get("armed", True):
        # 올릴 때 터미널이 다른 일을 하고 있었다 — 그 일이 끝나 쉬는 것을 한 번 본 뒤부터 '다시 일함 = 사람이 답함' 으로 본다
        if state in ("idle", "done"):
            j["armed"] = True; save(j)
        return "question"
    elif state == "working":
        j["phase"] = "answered"; j["answer"] = "(컴퓨터에서 직접 답함)"
    else:
        return "question"
    j["reported"] = True; j["finished_at"] = now().isoformat(); save(j)
    return j["phase"]


def cmd_ask(a):
    text = (sys.stdin.read() if a.question == "-" else a.question).strip()
    if not text:
        sys.exit("질문이 비었다")
    m = a.on or "local"
    addr = a.terminal if m == "local" or "/" in a.terminal else f"{m}/{a.terminal}"
    g = hc_json("get", addr, timeout=30)
    if "error" in g or not g.get("address"):
        sys.exit(f"없는 터미널: {addr}")
    body = text if text.startswith("질문") else "질문: " + text
    j = next((x for x in all_jobs() if x.get("kind") == "ask" and x.get("address") == addr and x.get("phase") == "question"), None)
    if j:      # 같은 터미널에 열린 질문이 있으면 새로 만들지 않고 고쳐서 다시 알린다
        j.update(result_text=body, task=text, reported=False); save(j)
        print(f"질문 고침 [{j['id']}] {addr}"); return
    jid = now().strftime("j%y%m%d-%H%M%S")
    st = g.get("status") or {}
    busy = (st.get("state") if isinstance(st, dict) else st) == "working"
    j = {"id": jid, "kind": "ask", "armed": not busy, "name": a.name or (a.project or addr), "project": a.project, "agent": "claude",
         "machine": m, "profile": "대화형", "cwd": (g.get("foreground") or {}).get("cwd") or g.get("cwd") or "", "task": text,
         "address": addr, "result": "", "result_text": body, "created_at": now().isoformat(), "phase": "question", "reported": False}
    save(j)
    print(f"질문 올림 [{jid}] {(a.project + ' · ') if a.project else ''}{addr} — 답: fleet-jobs send {jid} \"<답>\"")


def auto_dialog_keys(tail):
    """첫 실행 대화상자 중 답이 정해진 것: 누를 키 목록. 모르는 것은 None(사람에게)."""
    if "Bypass Permissions mode" in tail and "Yes, I accept" in tail:
        return ["down", "enter"]          # --dangerously-skip-permissions 는 ccp 설정(CCP_CLAUDE_ARGS)으로 이미 정한 것
    if "trust this folder" in tail or "Yes, I trust" in tail:
        return ["down", "enter"]
    if "Choose the text style" in tail:
        return ["enter"]
    if "fullscreen renderer" in tail:
        return ["esc"]
    return None


def screen_tail(j, lines=25):
    p = hc("read", j["address"], "--lines", str(lines), timeout=30)
    t = [l.rstrip() for l in p.stdout.splitlines() if l.strip() and not l.startswith("[hc]")]
    return "\n".join(t[-lines:])


def fmt(j, with_result=False):
    ph = j.get("phase", "?")
    label = {"running": "작업 중", "idle": "대기(결과 파일 없음)", "done": "완료", "question": "결정 필요(질문)", "answered": "답함", "blocked": "사람 필요(blocked)", "dialog": "대화상자에 멈춤(사람 필요)",
             "error": "오류", "exited": "종료됨", "stopped": "중지함", "lost": "터미널 없음"}.get(ph, ph)
    who = j['profile'] if j.get('agent', 'claude') == 'claude' else f"codex:{j.get('codex_profile', 'default')}"
    proj = f"{j['project']} · " if j.get('project') else ""
    if j.get("picked"):
        who += f"({j['picked']})"
    line = f"[{j['id']}] {proj}{j['machine']} · {who} · {label} · {j.get('name') or ''}".rstrip(" ·")
    body = [line, f"  작업: {j['task'].strip().splitlines()[0][:120]}", f"  폴더: {j['cwd']} · 시작 {j['created_at'][11:16]}"]
    if j.get("hc") and isinstance(j["hc"], dict) and j["hc"].get("exit_code") is not None:
        body.append(f"  exit {j['hc']['exit_code']}")
    if with_result:
        if j.get("result_text"):
            body.append("  결과:"); body += ["    " + l for l in j["result_text"].splitlines()[:30]]
        elif ph == "dialog":
            body.append("  화면:"); body += ["    " + l for l in j.get("dialog", "").splitlines()]
            body.append(f"  → 사람이 처리: hc keys {j['address']} down enter  (또는 fleet-jobs stop {j['id']})")
        elif ph != "running":
            body.append("  화면 꼬리:"); body += ["    " + l for l in screen_tail(j, 12).splitlines()]
    return "\n".join(body)


def cmd_dispatch(a):
    conf = cfg()
    try:
        r0 = resolve(conf, projects(), a.on, a.project, a.profile, a.cwd, a.agent)
    except ValueError as e:
        sys.exit(str(e))
    ms = machines()
    m = r0["machine"]
    if m != "local" and m not in ms:
        sys.exit(f"없는 머신: {m} (가능: local, {', '.join(ms)})")
    if m != "local" and ms[m] != "connected":
        sys.exit(f"{m} 는 지금 {ms[m]} 상태라 투입할 수 없다")
    r0 = settle(r0, conf, pick_remote(conf))
    profile, cwd, agent, cxp = r0["profile"], r0["cwd"], r0["agent"], r0["codex_profile"]
    # 허용 폴더 밖으로는 투입하지 않는다 — 투입된 작업은 권한 확인 없이 돌기 때문에 범위를 폴더로 묶는다.
    allowed = [os.path.expanduser(x) for x in conf.get("allowed_cwd", ["~/fleet-work", "~/projects"])]
    cwd_abs = os.path.normpath(os.path.expanduser(cwd))
    if not any(cwd_abs == p or cwd_abs.startswith(p.rstrip("/") + "/") for p in allowed):
        sys.exit(f"허용 폴더 밖: {cwd} (허용: {', '.join(conf.get('allowed_cwd', ['~/fleet-work', '~/projects']))} — ~/.config/ccp/fleet-dispatch.json 의 allowed_cwd)")
    task = sys.stdin.read() if a.task == "-" else a.task
    if not task.strip():
        sys.exit("작업문이 비었다")
    jid = now().strftime("j%y%m%d-%H%M%S")
    name = a.name or jid
    rdir = os.path.join(HOME, ".local/share/fleet-jobs")   # hc file/exec 는 '~' 를 풀지 않는다 — 절대 경로(네 Mac 모두 /Users/swh)
    task_path = f"{rdir}/{jid}.task"
    # 1) 폴더 준비 + 작업문 전달
    if m == "local":
        os.makedirs(rdir, exist_ok=True); os.makedirs(os.path.expanduser(cwd), exist_ok=True)
        open(task_path, "w").write(task)
    else:
        hc("exec", "--on", m, "sh", "-c", f"mkdir -p {rdir} {shlex.quote(os.path.expanduser(cwd))}", timeout=40, check=True)
        p = subprocess.run([HC, "file", "write", "--on", m, task_path], input=task, capture_output=True, text=True, timeout=60)
        if p.returncode:
            sys.exit("작업문 전달 실패: " + (p.stderr or p.stdout).strip())
    # 2) hc 터미널에서 fleet-job-run 실행 (ccp → claude, 데스크톱 core 라 키체인 열림)
    # --cwd 는 '~' 를 풀지 않는다. 원격은 홈 기준 상대 경로, 로컬은 절대 경로로 넘긴다.
    # --cwd 는 '~' 를 풀지 않는다(네 Mac 모두 홈이 /Users/swh 라 여기서 푼다). 명령은 argv 로 나눠 넘긴다 —
    # 한 문자열로 주면 --no-parent 와 함께일 때 셸 줄로 안 읽히고 프로그램 이름으로 취급돼 spawn_failed 가 난다.
    cwd_arg = os.path.expanduser(cwd)
    r = hc_json("run", *on(m), "--bg", "--no-notify", "--no-parent", "--cwd", cwd_arg, "--name", f"fj-{jid[1:]}",
                "zsh", "-lic", f"~/.local/bin/fleet-job-run {jid} {shlex.quote(profile)} {agent} {shlex.quote(cxp)}", timeout=60)
    if not r.get("address"):
        sys.exit("hc run 실패: " + json.dumps(r, ensure_ascii=False)[:300])
    j = {"id": jid, "name": name, "project": r0["project"], "agent": agent, "codex_profile": cxp,
         "machine": m, "profile": profile, "picked": r0.get("picked"), "cwd": cwd, "task": task, "address": r["address"],
         "result": f"{rdir}/{jid}.result.md", "created_at": now().isoformat(), "phase": "running", "reported": False}
    save(j)
    if a.json:
        print(json.dumps(j, ensure_ascii=False))
    else:
        who = profile if agent == "claude" else f"codex:{cxp}"
        how = f" ({r0['picked']})" if r0.get("picked") else ""
        print(f"투입함 [{jid}] {(r0['project'] + ' · ') if r0['project'] else ''}{m} · {who}{how} · {cwd} · 터미널 {r['address']}")
        print("  진행: fleet-jobs wait " + jid + "   결과: fleet-jobs result " + jid)


def cmd_list(a):
    js = all_jobs()
    if a.project:
        js = [j for j in js if j.get("project") == a.project]
    open_ask = lambda j: j.get("kind") == "ask" and j.get("phase") == "question"
    if not a.all:
        js = [j for j in js if j.get("phase") not in TERMINAL or not j.get("reported") or open_ask(j)]
    for j in js:
        if j.get("phase") not in TERMINAL or open_ask(j):
            phase(j)          # 열린 대화형 질문도 다시 본다 — 컴퓨터에서 답했으면 여기서 닫힌다
    if not a.all:
        js = [j for j in js if j.get("phase") not in TERMINAL or not j.get("reported") or open_ask(j)]
    if a.json:
        print(json.dumps(js, ensure_ascii=False)); return
    if not js:
        print("진행 중인 함대 작업 없음"); return
    for j in js:
        print(fmt(j))


def cmd_status(a):
    j = load(a.id); phase(j)
    print(json.dumps(j, ensure_ascii=False) if a.json else fmt(j, with_result=True))


def cmd_wait(a):
    j = load(a.id)
    deadline = time.time() + a.timeout
    idle_seen = 0
    dialog_seen = 0
    while True:
        ph = phase(j)
        if ph in TERMINAL:
            break
        if ph == "idle":
            idle_seen += 1
            if idle_seen >= 3:
                break
        if ph == "dialog":
            dialog_seen += 1
            if dialog_seen >= 2:
                break          # 사람이 눌러 줘야 한다 — 기다리지 않고 알린다
        remaining = deadline - time.time()
        if remaining <= 0:
            break
        step = int(min(remaining, 30)) or 1
        p = hc("wait", j["address"], "--timeout", str(step), timeout=step + 10)
        if p.returncode == 124:
            time.sleep(min(step, 10))
    phase(j)
    if j.get("phase") in TERMINAL:
        j["reported"] = True; save(j)
    print(json.dumps(j, ensure_ascii=False) if a.json else fmt(j, with_result=True))
    if j.get("phase") not in TERMINAL:
        print("  (아직 끝나지 않음 — 나중에 fleet-jobs wait 를 다시 부르거나 완료 알림을 기다린다)")


def cmd_result(a):
    j = load(a.id); phase(j)
    if j.get("result_text"):
        print(j["result_text"])
    else:
        print(f"(결과 파일 없음 · 상태 {j.get('phase')})"); print(screen_tail(j, 20))


def clear_result(j):
    """지난 결과(질문 포함)를 .prev 로 치운다 — 남겨 두면 send 직후 다음 판정이 곧바로 '완료'로 본다."""
    r = j["result"]
    if j["machine"] == "local":
        if os.path.exists(r):
            os.replace(r, r + ".prev")
    else:
        hc("exec", "--on", j["machine"], "sh", "-c", f"test -f {r} && mv -f {r} {r}.prev; true", timeout=40)


def cmd_send(a):
    j = load(a.id)
    if j.get("kind") == "ask":
        if ask_phase(j) != "question":
            sys.exit(f"이미 닫힌 질문 [{j['id']}] — {j.get('answer', j['phase'])}. 보내지 않았다.")
        p = hc("send", j["address"], a.message, timeout=60)
        j.update(phase="answered", answer=a.message, reported=True, finished_at=now().isoformat()); save(j)
        print(f"답을 {j['address']} 에 넣고 닫음 [{j['id']}]"); return
    if j.get("agent", "claude") == "codex":
        sys.exit("codex 작업은 끝나면 나간다 — 이어서 시킬 일은 새 작업으로 투입한다(이전 결과를 작업문에 붙여서)")
    clear_result(j)
    if "Enter to confirm" in screen_tail(j, 12):
        hc("keys", j["address"], "esc", timeout=30); time.sleep(1)   # 끝난 뒤 뜬 홍보 대화상자를 닫고 보낸다
    p = hc("send", j["address"], a.message, timeout=60)
    j["phase"] = "running"; j["reported"] = False; j.pop("result_text", None); save(j)
    print((p.stdout or p.stderr).strip() or "보냄")


def cmd_stop(a):
    j = load(a.id)
    if j.get("kind") == "ask":      # 사람의 터미널이다 — 죽이지 않고 질문만 닫는다
        j.update(phase="stopped", reported=True, finished_at=now().isoformat()); save(j)
        print(f"질문 닫음 [{j['id']}] (터미널은 그대로)"); return
    hc("kill", j["address"], timeout=30); hc("rm", j["address"], timeout=30)
    j["phase"] = "stopped"; j["reported"] = True; j["finished_at"] = now().isoformat(); save(j)
    print(f"중지함 [{j['id']}]")


def cmd_unreported(a):
    out = []
    for j in all_jobs():
        if j.get("reported"):
            continue
        if phase(j) in TERMINAL:
            out.append(fmt(j, with_result=True)); j["reported"] = True; save(j)
    if out:
        head = "함대 — 결정 필요" if any("결정 필요" in o.splitlines()[0] for o in out) else "함대 작업 완료"
        print(head + "\n" + "\n\n".join(out))


def cmd_clean(a):
    """알림까지 끝난 작업의 터미널을 치운다(기본: 끝난 지 6시간 넘은 것). 기록 JSON 은 남긴다."""
    n = 0
    for j in all_jobs():
        if j.get("kind") == "ask":
            continue                # 사람의 대화형 터미널은 치우지 않는다
        if j.get("phase") in TERMINAL and j.get("reported") and not j.get("cleaned"):
            fin = j.get("finished_at")
            age_h = (now() - datetime.datetime.fromisoformat(fin)).total_seconds() / 3600 if fin else 99
            if age_h >= a.age:
                hc("kill", j["address"], timeout=30); hc("rm", j["address"], timeout=30)
                j["cleaned"] = True; save(j); n += 1
    if n and not a.quiet:
        print(f"터미널 {n}개 정리")


def cmd_projects(a):
    ps = projects()
    if a.json:
        print(json.dumps(ps, ensure_ascii=False)); return
    if not ps:
        print(f"등록된 프로젝트 없음 ({PROJECTS})"); return
    for n, p in sorted(ps.items()):
        print(f"{n:12} {p.get('machine', 'local'):8} {p.get('cwd', ''):32} {p.get('label', '')}")


def cmd_machines(a):
    conf = cfg(); ms = machines()
    rows = [{"machine": "local", "state": "connected", **conf.get("machines", {}).get("local", {})}]
    rows += [{"machine": n, "state": s, **conf.get("machines", {}).get(n, {})} for n, s in ms.items()]
    if a.json:
        print(json.dumps(rows, ensure_ascii=False)); return
    for r in rows:
        print(f"{r['machine']:8} {r['state']:12} 기본 프로필 {r.get('profile','default'):12} {r.get('label','')}")


def main():
    ap = argparse.ArgumentParser(prog="fleet-jobs", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd")
    d = sp.add_parser("dispatch"); d.add_argument("--project"); d.add_argument("--agent", choices=AGENTS); d.add_argument("--on"); d.add_argument("--profile"); d.add_argument("--cwd"); d.add_argument("--name"); d.add_argument("--json", action="store_true"); d.add_argument("task"); d.set_defaults(f=cmd_dispatch)
    l = sp.add_parser("list"); l.add_argument("--all", action="store_true"); l.add_argument("--project"); l.add_argument("--json", action="store_true"); l.set_defaults(f=cmd_list)
    s = sp.add_parser("status"); s.add_argument("id"); s.add_argument("--json", action="store_true"); s.set_defaults(f=cmd_status)
    w = sp.add_parser("wait"); w.add_argument("id"); w.add_argument("--timeout", type=int, default=150); w.add_argument("--json", action="store_true"); w.set_defaults(f=cmd_wait)
    r = sp.add_parser("result"); r.add_argument("id"); r.set_defaults(f=cmd_result)
    se = sp.add_parser("send"); se.add_argument("id"); se.add_argument("message"); se.set_defaults(f=cmd_send)
    st = sp.add_parser("stop"); st.add_argument("id"); st.set_defaults(f=cmd_stop)
    ak = sp.add_parser("ask"); ak.add_argument("--on"); ak.add_argument("--terminal", required=True); ak.add_argument("--project"); ak.add_argument("--name"); ak.add_argument("question"); ak.set_defaults(f=cmd_ask)
    u = sp.add_parser("unreported"); u.set_defaults(f=cmd_unreported)
    c = sp.add_parser("clean"); c.add_argument("--age", type=float, default=6); c.add_argument("--quiet", action="store_true"); c.set_defaults(f=cmd_clean)
    pj = sp.add_parser("projects"); pj.add_argument("--json", action="store_true"); pj.set_defaults(f=cmd_projects)
    m = sp.add_parser("machines"); m.add_argument("--json", action="store_true"); m.set_defaults(f=cmd_machines)
    a = ap.parse_args()
    if not a.cmd:
        ap.print_help(); return
    a.f(a)


if __name__ == "__main__":
    main()
