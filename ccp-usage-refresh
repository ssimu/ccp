#!/usr/bin/env python3
"""로그인된 Claude 프로필을 순서대로 갱신한다. 실제 조회 값/식별자는 출력하지 않는다."""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from ccp_usage import refresh_all

if __name__ == '__main__':
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--min-age', type=float, default=600, help='최근 성공을 건너뛸 초 (기본 600)')
    ap.add_argument('--max-seconds', type=float, default=600, help='전체 시간 상한 초 (기본 600)')
    args = ap.parse_args()
    if args.min_age < 0 or args.max_seconds <= 0:
        ap.error('min-age >= 0, max-seconds > 0')
    refresh_all(min_age=args.min_age, max_seconds=args.max_seconds)
