# _ccp_t <키> [printf 인자...] — 현재 CCP_LANG 의 문구를 printf 형식으로 채워 낸다(줄바꿈 없음).
_ccp_t() {
  local key="$1"; shift
  local ref="_CCP_MSG_${CCP_LANG:-en}[${key}]"
  local fmt="${(P)ref}"
  [[ -z "$fmt" ]] && { ref="_CCP_MSG_en[${key}]"; fmt="${(P)ref}"; }
  printf -- "$fmt" "$@"
}
_ccp_tl() { _ccp_t "$@"; printf '\n'; }   # 줄바꿈 붙인 판
