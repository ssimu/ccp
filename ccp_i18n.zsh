  z_pick_week 'this week'
  z_pick_older 'earlier'
  z_pick_yesterday 'yesterday'
  z_pick_untitled '(untitled)'
  z_pick_held_mark '· held by profile %s'
  z_pick_cont_mark '· continued in %s'
  z_take_start '↩ bringing session %s (%s) over to account %s — a copy; the original stays as is'
  z_take_held '  ⚠ the original is still held by profile %s — clean up: ccp %s, then claude stop %s'
  z_take_none 'no conversation to bring over: %s'
  z_take_empty 'no conversations in this folder — starting a new one'
  z_take_ambig 'session ID '\''%s'\'' matches several: %s'
  z_take_codex '--take is claude-only — codex sessions can'\''t be brought over this way'
